[
  {
    "id": "alias-snapshot",
    "input": {
      "sources": [
        {
          "name": "base",
          "trusted": true,
          "yaml": "x: &base first\ny: *base\nz: see-${x}\n"
        },
        {
          "name": "next",
          "trusted": true,
          "yaml": "x: final\n"
        }
      ],
      "tags": true,
      "keys": {}
    },
    "expected": {
      "status": "ok",
      "entries": [
        [
          "x",
          [
            "next",
            1,
            1
          ],
          [
            "next",
            1,
            4
          ],
          true,
          "final"
        ],
        [
          "y",
          [
            "base",
            2,
            1
          ],
          [
            "base",
            1,
            4
          ],
          true,
          "first"
        ],
        [
          "z",
          [
            "base",
            3,
            1
          ],
          [
            "base",
            3,
            4
          ],
          true,
          "see-final"
        ]
      ],
      "dump": "x: \"final\"\ny: \"first\"\nz: \"see-${x}\"\n"
    }
  },
