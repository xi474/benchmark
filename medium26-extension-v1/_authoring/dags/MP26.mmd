    dates["下周五闭区间日期"]
    calendar["区间及已有晚餐索引"]
    plan["冲突取消及新增计划"]
    notifications["受影响对象去重通知"]
    apply["最终日历与幂等状态"]
    _core["组件结果集成"]
    _report["最终报告与摘要"]
    _verify["工作区外正式验证"]
    input --> dates
    input --> calendar
    dates --> plan
    calendar --> plan
    plan --> notifications
    calendar --> apply
    plan --> apply
    notifications --> apply
    dates --> _core
    calendar --> _core
    plan --> _core
    notifications --> _core
    apply --> _core
    _core --> _report
    _report --> _verify
