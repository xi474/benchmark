": [], "top_k": null, "all_required_accepted": false, "unverified_branches": [], "execution_mode": "parallel_v2", "offer_id": "v2-75b62ebcbb25", "logical_to_runtime_ids": {"relationship-windows": "v2-75b62ebcbb25-0", "record-subjects": "v2-75b62ebcbb25-1"}, "recovery_for_branch_id": null, "join_revision_node_id": null, "artifacts": [{"branch_id": "v2-75b62ebcbb25-0", "artifact_id": "artifact-f61609216ef999cb", "content": "{\"components/relationship_windows/work.py\": \"def compute(payload):\\n    \\\"\\\"\\\"将链接和合并登记为 [起点,终点,生效时刻,失效时刻]。保留原顺序并补齐缺省区间。\\\"\\\"\\\"\\n    result = []\\n    for item in payload.get(\\\"links\\\", []):\\n        result.append([\\n            item[\\\"a\\\"],\\n            item[\\\"b\\\"],\\n            item.get(\\\"from\\\", 0),\\n            item.get(\\\"to\\\", 10 ** 18),\\n        ])\\n    for item in payload.get(\\\"merges\\\", []):\\n        result.append([\\n            item[\\\"a\\\"],\\n            item[\\\"b\\\"],\\n            item.get(\\\"from\\\", 0),\\n            item.get(\\\"to\\\", 10 ** 18),\\n        ])\\n    return result\\n\", \"components/relationship_windows/result.json\": \"{\\\"component\\\": \\\"relationship_windows\\\", \\\"input_sha256\\\": \\\"8ea32d20e109dc3f1fb8186a7a10d98d0a180e6ba52d7b0a9e3ea9b807a2646c\\\", \\\"value\\\": [[[\\\"b\\\", \\\"u\\\"], [\\\"a\\\", \\\"t\\\"], 0, 1000000000000000000], [[\\\"a\\\", \\\"s\\\"], [\\\"a\\\", \\\"t\\\"], 5, 10]]}\"}", "content_sha256": "fb9036271b2cb6dbe935c8cb44e00f4e596aa42a967153db700828d9d19cacab", "validated": false, "delivery_verified": true, "materialized_files": {"components/relationship_windows/work.py": "6df68e1bd4ae945b86714f79c6b9b88d1c0e5f07ce1fc72e98d04f2a6da3b153", "components/relationship_windows/result.json": "d5ef94689290a0deff82ffd9f5cb9070dd7a915ae8ff00b16f875316e5f7cdb9"}, "tested_targets": []}, {"branch_id": "v2-75b62ebcbb25-1", "artifact_id": "artifact-3e6534648e36fbe2", "content": "{\"components/record_subjects/work.py\": \"def compute(payload):