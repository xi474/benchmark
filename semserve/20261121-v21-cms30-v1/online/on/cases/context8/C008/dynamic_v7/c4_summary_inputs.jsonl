bserved_seq": 30, "tool": "read_file", "path": "solution.py", "evidence_sha256": "24c68b4faaa756f505b84ef354183b307c78255ece7bf0aaef4be9187437436f", "arguments": {"path": "solution.py"}, "result": {"ok": true, "path": "solution.py", "content": "from component_runtime import read as load_payload, transform, build_component\n", "chars": 79, "truncated": false, "completed": true, "rerun_required": false, "runtime_fact": {"tool": "read_file", "operation_sha256": "baeb8da140bf977795a8d2cd34ec3889ce9908fde09df6084d77cdc40931d04f", "result_sha256": "0ca9d7bfd4c44432f38a65f1815e2fb6738b5a8ad38046485a8244344356598d", "progress_version": 21}}, "body_complete": true, "quote_options": [{"quote_id": "Q0044", "quote": "from component_runtime import read as load_payload, transform, build_component\n"}]}, {"source_key": "call_02_6XF8LUHfAyDfHpssN9JW3933#41502c222e6f", "runtime_evidence_id": "call_02_6XF8LUHfAyDfHpssN9JW3933", "observed_seq": 31, "tool": "read_file", "path": "public_input.json", "evidence_sha256": "834abd8e758906ad3c2442706537c1c329b847c434cdfa4ca09049e4ac3a4e2b", "arguments": {"path": "public_input.json"}, "result": {"ok": true, "path": "public_input.json", "content": "{\n  \"seed\": 1,\n  \"records\": [\n    {\n      \"table\": \"orders\",\n      \"id\": \"o1\",\n      \"tenant\": \"a\",\n      \"subject\": \"t\",\n      \"time\": 1\n    },\n    {\n      \"table\": \"history\",\n      \"id\": \"v1\",\n      \"tenant\": \"a\",\n      \"subject\": \"s\",\n      \"time\": 7\n    },\n    {\n      \"table\": \"events\",\n      \"id\": \"e1\",\n      \"tenant\": \"b\",\n      \"subject\": \"u\",\n      \"time\": 7\n    }\n  ],\n  \"links\": [\n    {\n      \"a\": [\n        \"b\",\n        \"u\"\n      ],\n      \"b\": [\n        \"a\",\n        \"t\"\n      ]\n    }\n  ],\n  \"merges\": [\n    {\n      \"a\": [\n        \"a\",\n        \"s\"\n      ],\n      \"b\": [\n        \"a\",\n        \"t\"\n      ],\n      \"from\": 5,\n      \"to\": 10\n    }\n  ]\n}\n", "chars": 661, "truncated": false, "completed": true, "rerun_required": false, "runtime_fact": {"tool": "read_file", "operation_sha256": "96cb782d304fa7aa2fb011ee0c63ea202dccb21ba05873f566fe45d84f50e15d", "result_sha256": "6438af69fa58ca65a2d02e58141805d86b8cceb08ed5227e7efeb9f4b9bf9c9e", "progress_version": 21}}, "body_complete": true, "quote_options": [{"quote_id": "Q0045", "quote": "  \"seed\": 1,"}, {"quote_id": "Q0046", "quote": "      \"id\": \"o1\","}, {"quote_id": "Q0047", "quote": "      \"time\": 1"}, {"quote_id": "Q0048", "quote": "      \"tenant\": \"a\","}, {"quote_id": "Q0049", "quote": "      \"time\": 7"}, {"quote_id": "Q0050", "quote": "      \"tenant\": \"b\","}, {"quote_id": "Q0051", "quote": "  \"links\": ["}, {"quote_id": "Q0052", "quote": "      \"to\": 10"}]}, {"source_key": "call_03_viGAx4lMjkUBenA3nxX96985#6cbcbeb4a7ec", "runtime_evidence_id": "call_03_viGAx4lMjkUBenA3nxX96985", "observed_seq": 32, "tool": "read_file", "path": "public_expected.json", "evidence_sha256": "746069c52990692949049822364d71f4626daf5a4a0782f37d956cb4462d4365", "arguments": {"path": "public_expected.json"}, "result": {"ok": true, "path": "public_expected.json", "content": "{\n  \"records\": [\n    {\n      \"table\": \"orders\",\n      \"id\": \"o1\",\n      \"time\": 1,\n      \"token\": \"ref_b2aa27409443\"\n    },\n    {\n      \"table\": \"history\",\n      \"id\": \"v1\",\n      \"time\": 7,\n      \"token\": \"ref_3c06ce39b13c\"\n    },\n    {\n      \"table\": \"events\",\n      \"id\": \"e1\",\n      \"time\": 7,\n      \"token\": \"ref_3c06ce39b13c\"\n    }\n  ]\n}\n", "chars": 344, "truncated": false, "completed": true, "rerun_required": false, "runtime_fact": {"tool": "read_file", "operation_sha256": "fbc7db3c5bf5dffc4e8ff01bcd0cf687f7cabc403277126e859f7aef245006ab", "result_sha256": "c528dd1b3a02f2047fb9852cc4e90f2e113ab8c03a2a087da5441c24506ae7c7", "progress_version": 21}}, "body_complete": true, "quote_options": [{"quote_id": "Q0053", "quote": "  \"records\": ["}, {"quote_id": "Q0054", "quote": "      \"id\": \"o1\","}, {"quote_id": "Q0055", "quote": "      \"time\": 1,"}, {"quote_id": "Q0056", "quote": "      \"table\": \"history\","}, {"quote_id": "Q0057", "quote": "      \"time\": 7,"}, {"quote_id": "Q0058", "quote": "      \"table\": \"events\","}, {"quote_id": "Q0059", "quote": "      \"id\": \"e1\","}, {"quote_id": "Q0060", "quote": "      \"token\": \"ref_3c06ce39b13c\""}]}, {"source_key": "call_04_0sji9on42B8QZZrwLsCi6459#56b7e59d5c5e", "runtime_evidence_id": "call_04_0sji9on42B8QZZrwLsCi6459", "observed_seq": 33, "tool": "read_file", "path": "component_runtime.py", "evidence_sha256": "876844e1fae75797b7a46b9917f48e633bbc3e240731752cc451eb0970bac064", "arguments": {"path": "component_runtime.py"}, "result": {"ok": true, "path": "component_runtime.py", "content": "\"\"\"Execute either independent component or assemble its two persisted artifacts.\"\"\"\nimport argparse\nfrom hashlib import sha256\nfrom importlib import import_module\nimport json\nimport math\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent\n\n\ndef read(path):\n    return json.loads(Path(path).read_text(encoding=\"utf-8\"))\n\n\ndef write(path, value):\n    Path(path).write_text(json.dumps(value, ensure_ascii=False, allow_nan=False), encoding=\"utf-8\")\n\n\nUNITS = read(ROOT / \"components.json\")\n\n\ndef project(payload, fields):\n    return {k: payload[k] for k in fields if k in payload}\n\n\ndef fingerprint(value):\n    text = json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False, allow_nan=False)\n    return sha256(text.encode(\"utf-8\")).hexdigest()\n\n\ndef sample_matches(actual, expected, tolerance):\n    if isinstance(actual, bool) or isinstance(expected, bool):\n        return type(actual) == type(expected) and actual == expected\n    if isinstance(actual, (int, float)) and isinstance(expected, (int, float)):\n        atol = tolerance.get(\"atol\", 0) if isinstance(tolerance, dict) else tolerance\n        rtol = tolerance.get(\"rtol\", 0) if isinstance(tolerance, dict) else 0\n        return math.isfinite(actual) and abs(actual - expected) <= atol + rtol * abs(expected)\n    if isinstance(actual, dict) and isinstance(expected, dict):\n        return actual.keys() == expected.keys() and all(sample_matches(actual[k], expected[k], tolerance) for k in actual)\n    if isinstance(actual, list) and isinstance(expected, list):\n        return len(actual) == len(expected) and all(sample_matches(x, y, tolerance) for x, y in zip(actual, expected))\n    return type(actual) == type(expected) and actual == expected\n\n\ndef evaluate_unit(name, payload):\n    return import_module(\"components.\" + name + \".work\").compute(payload)\n\n\ndef persist(name, payload):\n    folder = ROOT / \"components\" / name\n    # Invalidate the slot before running so a failed retry cannot reuse an old result.\n    write(folder / \"result.json\", None)\n    value = evaluate_unit(name, payload)\n    record = dict(component=name, input_sha256=fingerprint(payload), value=value)\n    write(folder / \"result.json\", record)\n    return record\n\n\ndef assemble(payload):\n    from integration import combine\n    values = []\n    for name, fields in UNITS.items():\n        record = read(ROOT / \"components\" / name / \"result.json\")\n        if not isinstance(record, dict) or record.get(\"component\") != name or record.get(\"input_sha256\") != fingerprint(project(payload, fields)):\n            raise ValueError(f\"{name} has no result for the given input\")\n        values.append(record[\"value\"])\n    return combine(payload, *values)\n\n\ndef transform(payload):\n    from integration import combine\n    values = [evaluate_unit(name, project(payload, fields)) for name, fields in UNITS.items()]\n    return combine(payload, *values)\n\n\ndef build_component(input_path, output_path):\n    payload = read(input_path)\n    out = Path(output_path)\n    if Path(input_path).resolve() == ROOT / \"public_input.json\" and out.resolve() == ROOT / \"outputs/result.json\":\n        for name, fields in UNITS.items():\n            persist(name, project(payload, fields))\n        value = assemble(payload)\n    else:\n        value = transform(payload)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    write(out, value)\n    return value\n\n\ndef main():\n    arg = argparse.ArgumentParser()\n    arg.add_argument(\"action\", choices=(\"run\", \"check\", \"join\"))\n    arg.add_argument(\"component\", nargs=\"?\", choices=tuple(UNITS))\n    arg.add_argument(\"--input\", type=Path, help=\"Full business input for run or join\")\n    arg.add_argument(\"--output\", type=Path, default=ROOT / \"outputs/result.json\")\n    args = arg.parse_args()\n    if args.action == \"join\":\n        if args.component:arg.error(\"join accepts no component\")\n        write(args.output, assemble(read(args.input or ROOT / \"public_input.json\")))\n        return\n    if not args.component:arg.error(\"select a component\")\n    name = args.component\n    folder = ROOT / \"components\" / name\n    if args.action == \"check\":\n        if args.input:arg.error(\"check uses the component's public fixture\")\n        value = evaluate_unit(name, read(folder / \"input.json\"))\n        # Compare the JSON representation: tuples and JSON arrays have the same wire form.\n        normalized = json.loads(json.dumps(value, allow_nan=False))\n        if not sample_matches(normalized, read(folder / \"expected.json\"), read(ROOT / \"work_units.json\")[\"sample_tolerance\"]):\n            raise SystemExit(f\"{name}: failed public example\")\n        print(f\"{name}: passed public example\")\n    else:\n        payload = project(read(args.input), UNITS[name]) if args.input else read(folder / \"input.json\")\n        persist(name, payload)\n\n\nif __name__ == \"__main__\":\n    main()\n", "chars": 4831, "truncated": false, "completed": true, "rerun_required": false, "runtime_fact": {"tool": "read_file", "op